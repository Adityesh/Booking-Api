<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>a437055d-3d2a-4550-91cf-ea8f3b6b071e</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
