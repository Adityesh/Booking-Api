{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      // shadcn/ui components are generated by `npx shadcn add` and export their cva helpers (buttonVariants) next to
      // the component. Fast refresh falls back to a full reload for these files, which is fine for vendored code.
      "files": ["src/components/ui/**"],
      "rules": { "react/only-export-components": "off" }
    }
  ]
}
