  "components": {
    "schemas": {
      "ActionType": {
        "enum": [
          "BookingCreated",
          "BookingCancelled",
          "WaitlistEntryCreated",
          "WaitlistEntryPromoted",
          "WaitlistEntryExpired",
          "WaitlistEntryWithdrawn",
          "ResourceCreated",
          "ResourceUpdated",
          "ResourceDeleted"
        ]
      },
      "AuditLogResponseDto": {
        "required": [
          "id",
          "entityId",
          "userId",
          "timestamp",
          "action"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "entityId": {
            "type": "integer",
            "format": "int32"
          },
          "userId": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "action": {
            "$ref": "#/components/schemas/ActionType"
          }
        }
      },
      "AuthResponseDto": {
        "required": [
