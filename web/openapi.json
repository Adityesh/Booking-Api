          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AverageBookingDurationDto": {
        "required": [
          "bookingCount",
          "averageMinutes"
        ],
        "type": "object",
        "properties": {
          "bookingCount": {
            "type": "integer",
            "format": "int32"
          },
          "averageMinutes": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          }
        }
      },
      "BookingListItemDto": {
        "required": [
          "id",
          "resourceId",
          "resourceName",
          "startTime",
          "endTime",
          "status",
          "userId",
          "username"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "resourceId": {
            "type": "integer",
            "format": "int32"
          },
